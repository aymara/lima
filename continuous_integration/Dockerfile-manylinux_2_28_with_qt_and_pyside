ARG PYTHON_VERSION
ARG QT_VERSION
# MANYLINUX: the manylinux base, manylinux_2_28 (AlmaLinux 8, the Qt 6.9
# chain) or manylinux_2_34 (AlmaLinux 9, the Qt 6.12 chain); the image names
# hold it
ARG MANYLINUX=manylinux_2_28
ARG MANYLINUX_TAG
FROM aymara/${MANYLINUX}_with_qt${QT_VERSION}:latest as aymara_manylinux_2_28_with_qt
ARG MANYLINUX_TAG
FROM quay.io/pypa/${MANYLINUX}_x86_64:${MANYLINUX_TAG}

ARG GCC_VERSION
# The gcc-toolset of the base (11 on manylinux_2_28, 14 on manylinux_2_34)
ARG GCC_TOOLSET=11
ARG QT_VERSION
ARG QT_VERSION_MAJOR
ARG QT_FULL_VERSION
ARG PYSIDE_VERSION
ARG PYTHON_VERSION
ARG PYTHON_SHORT_VERSION
ARG PYTHON_FULL_VERSION

COPY --from=aymara_manylinux_2_28_with_qt /opt /opt
COPY --from=aymara_manylinux_2_28_with_qt /usr/local /usr/local
ENV Qt_INSTALL_DIR=/opt/qt6

ENV PATH="/opt/python/${PYTHON_SHORT_VERSION}/bin:${PATH}"

# --nogpgcheck: the manylinux_2_28 (AlmaLinux 8) base repos fail GPG verification
# (expired/missing keys), matching Dockerfile-manylinux_2_28_with_boost.
RUN yum install -y --nogpgcheck --allowerasing --nobest wget gcc-toolset-${GCC_TOOLSET}.x86_64 ninja-build libicu-devel.x86_64 \
    clang.x86_64 python3-clang.x86_64 llvm-devel.x86_64 clang-devel.x86_64 libxml2-devel.x86_64 libxslt-devel.x86_64 \
    python3-sphinx.noarch
# RUN ln -s /usr/bin/uic-qt5 /usr/bin/uic && \
#     ln -s /usr/bin/rcc-qt5 /usr/bin/rcc &&
# libclang.so.1: libclang's soname, whatever its version (13, 18, 22...)
RUN    lib=$(ls /usr/lib64/libclang.so.[0-9]* 2>/dev/null | head -n1); \
       if [ -n "$lib" ] && [ ! -e /usr/lib64/libclang.so.1 ]; then ln -s "$lib" /usr/lib64/libclang.so.1; fi
ENV CC=/opt/rh/gcc-toolset-${GCC_TOOLSET}/root/usr/bin/gcc \
    CXX=/opt/rh/gcc-toolset-${GCC_TOOLSET}/root/usr/bin/g++

RUN python${PYTHON_VERSION} -m pip install scikit-build

# Install PySide${QT_VERSION_MAJOR} and shiboken${QT_VERSION_MAJOR} from source as binary installs are broken
# Done in /home/gael/Logiciels/
WORKDIR /
RUN echo "Downloading https://download.qt.io/official_releases/QtForPython/pyside${PYSIDE_VERSION}/PySide${PYSIDE_VERSION}-${QT_FULL_VERSION}-src/pyside-setup-everywhere-src-${QT_FULL_VERSION}.tar.xz" && wget -q https://download.qt.io/official_releases/QtForPython/pyside${PYSIDE_VERSION}/PySide${PYSIDE_VERSION}-${QT_FULL_VERSION}-src/pyside-setup-everywhere-src-${QT_FULL_VERSION}.tar.xz && tar xf pyside-setup-everywhere-src-${QT_FULL_VERSION}.tar.xz && mv /pyside-setup-everywhere-src-${QT_FULL_VERSION} /pyside-setup && rm pyside-setup-everywhere-src-${QT_FULL_VERSION}.tar.xz
WORKDIR /pyside-setup

# Touch files needed for setup but not used in fact
RUN install -d /opt/_internal/cpython-${PYTHON_FULL_VERSION}/lib/x86_64-linux-gnu/ && touch /opt/_internal/cpython-${PYTHON_FULL_VERSION}/lib/x86_64-linux-gnu/libpython${PYTHON_VERSION}.a && touch /opt/_internal/cpython-${PYTHON_FULL_VERSION}/lib/x86_64-linux-gnu/libpython${PYTHON_VERSION}m.a

# CLANG_RESOURCE_DIR is set in the build step, from clang itself. Clang's
# builtin headers must not go in CPLUS_INCLUDE_PATH: GCC compiles the build
# too and cannot compile them ("missing binary operator", clang 18 and 22
# alike); shiboken finds them without it. The former setting
# (/usr/lib64/clang/18/include) was a path that did not exist (clang's
# resource dir is /usr/lib/clang/<major>), so it did nothing
# Force Shiboken's internal locator to look into the actual toolset path
ENV LLVM_INSTALL_DIR=/usr
ENV CLANG_INSTALL_DIR=/usr

# Symlink the internal layout so if Shiboken looks for /usr/lib/clang, it hits lib64
RUN [ -e /usr/lib/clang ] || ln -s /usr/lib64/clang /usr/lib/clang

WORKDIR /pyside-setup
RUN export CLANG_RESOURCE_DIR=$(realpath "$(clang -print-resource-dir)") && \
    python${PYTHON_VERSION} setup.py install --build-type=all --limited-api=yes --qtpaths=/opt/qt6/bin/qtpaths \
                        --ignore-git \
                        --module-subset=Core

WORKDIR /
RUN rm -Rf /pyside-setup

