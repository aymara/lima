# Doxygen configuration for the C++ API reference published on the
# documentation site under /api/cpp/ (see .github/workflows/docs.yml).
# Run from the repository root: doxygen docs/Doxyfile
# (The per-subproject Doxyfile.in files are used by the CMake build instead.)

PROJECT_NAME           = "LIMA"
PROJECT_BRIEF          = "Libre Multilingual Analyzer — C++ API"
PROJECT_LOGO           = pics/64-apps-lima.png
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = lima_common/src \
                         lima_linguisticprocessing/src \
                         deeplima/include \
                         deeplima/libs
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */tests/* */test/* */.git/*
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = lima_common/src lima_linguisticprocessing/src deeplima/include

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = build/doxygen/warnings.log
QUIET                  = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
HTML_COLORSTYLE        = TOGGLE
GENERATE_LATEX         = NO
GENERATE_XML           = NO

SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
HAVE_DOT               = NO
CLASS_GRAPH            = YES
